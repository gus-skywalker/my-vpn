[Unit]
Description=VPN traffic ledger and durable byte quota (no LLM)
Requires=docker.service
PartOf=docker.service
After=docker.service network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Environment=HOME=/nonexistent
WorkingDirectory=/opt/hermes-security-vpn
ExecStart=/usr/bin/python3 /opt/hermes-security-vpn/scripts/traffic-meter.py run
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/hermes-security-vpn/state/traffic
MemoryMax=128M
TasksMax=64
CPUQuota=10%

[Install]
WantedBy=multi-user.target
